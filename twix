#!/usr/bin/env -S bash -e

THIS_DIRECTORY="$(dirname "$(readlink -f "$0")")"

features=()
transport=()
simulator=false
bhuman=false
simulator_dry_run=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --simulator) simulator=true ;;
    --bhuman) simulator=true; bhuman=true ;;
    --dry-run) simulator_dry_run=true ;;
    --help|-h)
      cat <<'HELP'
Usage: ./twix [--simulator] [--bhuman] [--dry-run] [TWIX_ARGS...]
  --simulator  Enable the simulator and set up MuJoCo, CPU ONNX Runtime and LFS assets.
  --bhuman     Also build native B-Human 2026 opponents (Linux x86-64).
  --dry-run    Print setup paths and Cargo command without downloads or builds.
Pass -- --help to see Twix's application options.
Overrides: MUJOCO_DOWNLOAD_DIR, MUJOCO_DYNAMIC_LINK_DIR, MUJOCO_STATIC_LINK_DIR,
ORT_DYLIB_PATH, BHUMAN_WORKER + BHUMAN_SOURCE, BHUMAN_JOBS, XDG_CACHE_HOME.
HELP
      exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

source "$THIS_DIRECTORY/tools/simulate/runtime.sh"
if $simulator; then
  features=(--features simulator)
  transport=(--zenoh-namespace hulk_simulator)
  simulator_prepare "$THIS_DIRECTORY" "$bhuman"
fi

if $bhuman; then
  features=(--features bhuman)
fi

if $simulator; then
  cd "$THIS_DIRECTORY"
fi
simulator_launch cargo run --manifest-path="${THIS_DIRECTORY}/tools/twix/Cargo.toml" "${features[@]}" -- "${transport[@]}" "$@"
